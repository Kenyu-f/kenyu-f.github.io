---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Kenyu FUJIMOTO">
  <div class="home-container">
    <section class="intro">
      <h1>Kenyu FUJIMOTO</h1>
      <p>
        I am a student based in Japan, deeply engaged in mathematics, computer science, and linguistics. </p>

      <p>
      私は日本に住んでいる学生です。数学、コンピュータサイエンス、言語学に没頭しています。

      </p>
    </section>

    <div class="profile-image-wrapper">

      <img src="/myphoto.jpg" alt="Kenyu FUJIMOTO" class="profile-photo" />

      <div class="placeholder-image"></div>
    </div>

    <section class="interests">
      <h2 class="section-title">Research Interests</h2>
      <ul>
        <li>Number theory</li>
        <li>Computational tools in education</li>
        <li>How language works</li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .home-container {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin-top: 2rem;
  }

  .intro h1 {
    margin-top: 0;
    font-size: 2.8rem;
  }

  .intro p {
    font-size: 1.15rem;
    max-width: 540px;
    line-height: 1.8;
  }

  .profile-image-wrapper {
    margin: 1rem 0;
  }

  .placeholder-image {
    width: 240px;
    height: 300px;
    background-color: #f9f9f9;
    border: 1px solid #f0f0f0;
  }

  .profile-photo {
    width: 240px;
    height: auto;
    filter: grayscale(100%);
    opacity: 0.9;
  }

  .section-title {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-gray);
    margin-bottom: 2rem;
  }

  ul {
    list-style-type: none;
    padding-left: 0;
  }

  li {
    margin-bottom: 0.75rem;
    font-size: 1.05rem;
  }

  li::before {
    content: "—";
    margin-right: 1rem;
    color: var(--color-border);
  }
</style>
