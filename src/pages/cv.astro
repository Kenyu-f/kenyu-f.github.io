---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="CV | Kenyu F">
  <article>
    <h1>Curriculum Vitae</h1>
    
    <div class="cv-actions">
      <a href="/cv.pdf" class="btn">[Download PDF]</a>
    </div>

    <section>
      <h2>Education</h2>
      <p>[Education placeholder]</p>
    </section>

    <section>
      <h2>Experience</h2>
      <p>[Experience placeholder]</p>
    </section>

    <section>
      <h2>Honors & Awards</h2>
      <p>[Awards placeholder]</p>
    </section>
  </article>
</BaseLayout>

<style>
  .cv-actions {
    margin-bottom: 3rem;
  }

  h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-gray);
    margin-bottom: 2rem;
    margin-top: 4rem;
  }
</style>
