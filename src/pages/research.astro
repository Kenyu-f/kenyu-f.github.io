---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Research | Kenyu F.">
  <article>
    <h1>Research</h1>
    
    <section id="statement">
      <h2>Research Statement</h2>
      <p>[Research statement placeholder]</p>
    </section>

    <section id="interests">
      <h2>Interests</h2>
      <ul>
        <li>[Interest 1]</li>
        <li>[Interest 2]</li>
      </ul>
    </section>

    <section id="questions">
      <h2>Current Questions</h2>
      <p>[Current questions placeholder]</p>
    </section>

    <section id="directions">
      <h2>Ongoing Directions</h2>
      <p>[Ongoing directions placeholder]</p>
    </section>

    <section id="writing">
      <h2>Selected Writing</h2>
      <p>[Selected writing placeholder]</p>
    </section>

    <section id="projects">
      <h2>Selected Projects</h2>
      <p>[Selected projects placeholder]</p>
    </section>
  </article>
</BaseLayout>

<style>
  section {
    margin-bottom: 3rem;
  }
  
  h2 {
    font-family: var(--font-sans);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gray);
    border-bottom: 1px solid var(--color-light-gray);
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
  }
</style>
