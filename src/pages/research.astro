---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Research | Kenyu FUJIMOTOUJIMOTO">
  <article>
    <h1>Research</h1>
    
    <section id="statement">
      <h2>Research Statement</h2>
      <p>[Research statement placeholder]</p>
    </section>

    <section id="interests">
      <h2>Interests</h2>
      <ul>
        <li>ケーリーディクソン代数的な代数拡大の手法。</li>
        <li>モデル理論、型理論での数学の証明の厳密な表現。</li>
      </ul>
    </section>

    <section id="questions">
      <h2>Current Questions</h2>
      <p>[Current questions placeholder]</p>
    </section>

    <section id="directions">
      <h2>Ongoing Directions</h2>
      <p>[Ongoing directions placeholder]</p>
    </section>

    <section id="writing">
      <h2>Selected Writing</h2>
      <p>[Selected writing placeholder]</p>
    </section>

    <section id="projects">
      <h2>Selected Projects</h2>
      <p>[Selected projects placeholder]</p>
    </section>
  </article>
</BaseLayout>

<style>
  section {
    margin-bottom: 5rem;
  }
  
  h2 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-gray);
    margin-bottom: 2rem;
  }
</style>
