---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf()
);
---

<BaseLayout title="Projects | Kenyu F">
  <h1>Projects</h1>
  
  <div class="project-list">
    {projects.length > 0 ? (
      projects.map(project => (
        <article class="project-item">
          <div class="year quiet">
            {project.data.startDate.getFullYear()}
          </div>
          <div class="details">
            <h2 class="project-title">{project.data.title}</h2>
            <p class="description">{project.data.description}</p>
            <div class="links">
              {project.data.repository && <a href={project.data.repository}>Repository</a>}
              {project.data.demo && <a href={project.data.demo}>Demo</a>}
            </div>
          </div>
        </article>
      ))
    ) : (
      <p><em>No projects listed yet.</em></p>
    )}
  </div>
</BaseLayout>

<style>
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    margin-top: 3rem;
  }

  .project-item {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.5rem;
  }

  .year {
    font-size: 0.95rem;
    padding-top: 0.2rem;
  }

  .project-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
  }

  .description {
    margin: 0 0 1rem 0;
    font-size: 1rem;
    max-width: 560px;
  }

  .links {
    display: flex;
    gap: 1.5rem;
    font-size: 0.85rem;
  }

  .links a {
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray);
    border-bottom: 1px solid var(--color-border);
  }

  .links a:hover {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }

  @media (max-width: 600px) {
    .project-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
