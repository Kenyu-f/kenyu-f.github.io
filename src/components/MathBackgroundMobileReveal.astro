---
import katex from 'katex';
import type { MathBgConfig } from '../lib/mathBgPresets';

interface Props extends MathBgConfig {}

const { formulas, motifs = [] } = Astro.props as Props;

const render = (tex: string, displayMode: boolean) =>
  katex.renderToString(tex, { throwOnError: false, displayMode, output: 'html' });

const items = [...formulas.map((t) => render(t, true)), ...motifs.map((t) => render(t, false))];
---

<div class="math-reveal" aria-hidden="true">
  <p class="math-reveal-label">∿</p>
  <div class="math-reveal-items">
    {items.map((html) => (
      <div class="math-reveal-item" set:html={html} />
    ))}
  </div>
</div>

<style>
  .math-reveal {
    display: none;
  }

  @media (max-width: 700px) {
    .math-reveal {
      display: block;
      margin-top: 3rem;
      padding: 1.5rem 1.25rem 2.5rem;
      border-top: 1px solid var(--color-border);
      text-align: center;
      color: var(--color-text);
    }

    .math-reveal-label {
      opacity: 0.4;
      margin: 0 0 1rem;
      font-size: 1.1rem;
    }

    .math-reveal-items {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      opacity: 0.45;
    }

    .math-reveal-item :global(.katex) {
      font-size: 1rem;
    }
  }
</style>
