---
import katex from 'katex';
import { generateTilingEdges } from '../lib/hyperbolicTiling';
import { generatePadicDisk, type PadicCircle } from '../lib/padicDisk';
import type { MathBgConfig } from '../lib/mathBgPresets';

interface Props extends MathBgConfig {}

const { pattern, p, q, rotOffset = 0, depth, spinSeconds = 210, formulas } = Astro.props as Props;

const edges =
  pattern === 'hyperbolic' && q
    ? generateTilingEdges(p, q, { depth: depth ?? 3, maxAbs: 0.9, rotOffset })
    : [];

const circles: PadicCircle[] = pattern === 'padic' ? generatePadicDisk(p, { depth: depth ?? 4, rotOffset }) : [];

const render = (tex: string) => katex.renderToString(tex, { throwOnError: false, displayMode: true, output: 'html' });

// Hyperbolic pages: plain corner slots, capped at 4, never rotated.
const cornerFormulaHtml = pattern === 'hyperbolic' ? formulas.slice(0, 4).map(render) : [];

// p-adic pages: one formula per large circle, so labels can't collide —
// picked from the biggest circles (lowest recursion level) first.
const diskLabels =
  pattern === 'padic'
    ? [...circles]
        .filter((c) => c.level <= 1)
        .sort((a, b) => b.r - a.r)
        .slice(0, formulas.length)
        .map((c, i) => ({ circle: c, html: render(formulas[i]) }))
    : [];
---

<div class="math-bg" aria-hidden="true">
  <svg
    class:list={['pattern-svg', pattern]}
    style={`animation-duration:${spinSeconds}s`}
    viewBox="-1.05 -1.05 2.1 2.1"
    preserveAspectRatio="xMidYMid meet"
  >
    <circle cx="0" cy="0" r="1" class="boundary" />
    {pattern === 'hyperbolic' && edges.map((d) => <path d={d} />)}
    {pattern === 'padic' && circles.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} />)}
  </svg>

  {pattern === 'padic' && (
    <div class="disk-formulas" style={`animation-duration:${spinSeconds}s`}>
      {diskLabels.map(({ circle, html }) => (
        <div
          class="disk-formula"
          style={`left:${((circle.cx + 1) / 2) * 100}%;top:${((circle.cy + 1) / 2) * 100}%;`}
          set:html={html}
        />
      ))}
    </div>
  )}

  {pattern === 'hyperbolic' && (
    <div class="formulas">
      {cornerFormulaHtml.map((html, i) => (
        <div class={`formula slot-${i + 1}`} set:html={html} />
      ))}
    </div>
  )}
</div>

<style>
  .math-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    color: var(--color-text);
  }

  .pattern-svg {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(150vmax, 1400px);
    height: min(150vmax, 1400px);
    transform: translate(-50%, -50%);
    opacity: 0.055;
    animation-name: spin;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .pattern-svg.hyperbolic path {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.0035;
  }

  .pattern-svg.padic circle:not(.boundary) {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.003;
  }

  .pattern-svg .boundary {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.002;
  }

  /* Same size/position/rotation as .pattern-svg, so labels placed inside
     ride along with the disk at exactly the same speed. */
  .disk-formulas {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(150vmax, 1400px);
    height: min(150vmax, 1400px);
    transform: translate(-50%, -50%);
    animation-name: spin;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .disk-formula {
    position: absolute;
    transform: translate(-50%, -50%);
    opacity: 0.13;
    font-size: clamp(0.85rem, 1.7vw, 1.15rem);
    white-space: nowrap;
  }

  @keyframes spin {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  .formulas {
    position: absolute;
    inset: 0;
  }

  .formula {
    position: absolute;
    opacity: 0.11;
    font-size: clamp(1.05rem, 2.2vw, 1.5rem);
    white-space: nowrap;
  }

  /* Four widely separated, horizontal-only corners — no rotation, no crowding. */
  .slot-1 {
    top: 8%;
    right: 6%;
  }
  .slot-2 {
    bottom: 10%;
    left: 5%;
  }
  .slot-3 {
    top: 8%;
    left: 6%;
  }
  .slot-4 {
    bottom: 10%;
    right: 5%;
  }

  @media (max-width: 700px) {
    .formula,
    .disk-formula {
      display: none;
    }
    .formula.slot-1 {
      display: block;
      top: 4%;
      right: 4%;
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pattern-svg,
    .disk-formulas {
      animation: none;
    }
  }
</style>
