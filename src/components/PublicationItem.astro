---
const { pub } = Astro.props;
const { title, authors, year, venue, status, pdf, doi, tags } = pub.data;
---

<div class="pub-item">
  <div class="metadata">
    <span class="status-tag" data-status={status}>{status}</span>
    <span class="year">{year}</span>
  </div>
  <h3 class="title">{title}</h3>
  <div class="authors">
    {authors.map((author, index) => (
      <span>
        {author}{index < authors.length - 1 ? ', ' : ''}
      </span>
    ))}
  </div>
  <div class="venue">
    {venue && <em>{venue}</em>}
  </div>
  <div class="links">
    {pdf && <a href={pdf}>[pdf]</a>}
    {doi && <a href={`https://doi.org/${doi}`}>[doi]</a>}
  </div>
</div>

<style>
  .pub-item {
    margin-bottom: 2.5rem;
  }

  .metadata {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
  }

  .status-tag {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gray);
    border: 1px solid var(--color-light-gray);
    padding: 1px 4px;
    border-radius: 2px;
  }

  .status-tag[data-status="published"] {
    color: #2e7d32;
    border-color: #a5d6a7;
  }

  .year {
    color: var(--color-gray);
  }

  .title {
    font-size: 1.1rem;
    margin: 0 0 0.25rem 0;
    line-height: 1.3;
  }

  .authors {
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }

  .venue {
    font-size: 0.95rem;
    color: var(--color-gray);
    margin-bottom: 0.5rem;
  }

  .links {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    display: flex;
    gap: 0.75rem;
  }

  .links a {
    text-decoration: none;
    color: var(--color-gray);
  }

  .links a:hover {
    color: var(--color-text);
    text-decoration: underline;
  }
</style>
