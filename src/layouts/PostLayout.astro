---
import BaseLayout from '../layouts/BaseLayout.astro';
const { title, date, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article>
    <header>
      <h1>{title}</h1>
      <div class="metadata quiet">
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString('en-us', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </div>
    </header>
    
    <div class="content">
      <slot />
    </div>

    <footer>
      <hr />
      <p><a href="/blog">← Back to blog</a></p>
    </footer>
  </article>
</BaseLayout>

<style>
  header {
    margin-bottom: 4rem;
  }
  
  header h1 {
    margin-bottom: 1rem;
    font-size: 2.5rem;
    line-height: 1.2;
    font-weight: 400;
  }

  .content h1 {
    font-size: 1.5rem;
    font-weight: 400;
  }

  .metadata {
    font-size: 0.95rem;
  }

  .content {
    margin-bottom: 6rem;
  }

  footer {
    margin-top: 4rem;
    font-size: 0.95rem;
  }

  footer hr {
    margin: 2rem 0;
  }
</style>
