---
import BaseLayout from '../layouts/BaseLayout.astro';
import { mathBgForSlug } from '../lib/mathBgPresets';
const { title, date, description, slug } = Astro.props;
const mathBg = mathBgForSlug(slug ?? title ?? '');
---

<BaseLayout title={title} description={description} mathBg={mathBg}>
  <article>
    <header>
      <h1>{title}</h1>
      <div class="metadata quiet">
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString('en-us', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </div>
    </header>
    
    <div class="content">
      <slot />
    </div>

    <footer>
      <hr />
      <p><a href="/blog">← Back to blog</a></p>
    </footer>
  </article>
</BaseLayout>

<style>
  header {
    margin-bottom: 2rem;
  }
  
  header h1 {
    margin-bottom: 0.75rem;
    font-size: 2.2rem;
    line-height: 1.2;
    font-weight: 400;
  }

  .content h1 {
    font-size: 1.4rem;
    font-weight: 400;
  }

  .metadata {
    font-size: 0.9rem;
  }

  .content {
    margin-bottom: 3rem;
  }

  footer {
    margin-top: 2rem;
    font-size: 0.9rem;
  }

  footer hr {
    margin: 1.5rem 0;
  }
</style>
