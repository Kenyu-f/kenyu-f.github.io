---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MathBackground from '../components/MathBackground.astro';
import MathBackgroundMobileReveal from '../components/MathBackgroundMobileReveal.astro';
import { PAGE_PRESETS, type MathBgConfig } from '../lib/mathBgPresets';
import 'katex/dist/katex.min.css';


interface Props {
  title?: string;
  description?: string;
  mathBg?: MathBgConfig;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, mathBg = PAGE_PRESETS.home } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="favicon-32x32.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Typography: Cormorant Garamond for titles, Hiragino Sans for body -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@700&display=swap" rel="stylesheet">
    <link rel="stylesheet" media="screen" href="https://fontlibrary.org//face/cmu-sans-serif" type="text/css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/computer-modern@0.1.3/cmu-sans-serif.min.css">
    
    <style is:global>
      :root {
        --font-serif: "CMU Sans Serif",  serif;
        --font-sans:  "CMU Sans Serif", "Noto Sans JP", sans-serif;
        --font-cmu-sans: "CMUSansSerifBold", "CMU Sans Serif", "Computer Modern Sans", sans-serif;
        --color-text: #1a1a1a;
        --color-bg: #fefefe;
        --color-gray: #5a6672;
        --color-border: #b6c2cc;
        --color-box-bg: #f4f7f9;
        --color-link: #14548c;
        --color-link-hover: #0c3a63;
        --max-width: 860px;
        --spacing-unit: 1.5rem;
      }

      * {
        box-sizing: border-box;
      }

      html {
        font-size: 16px;
      }

      body {
        font-family: var(--font-sans);
        font-weight: 300;
        line-height: 1.55;
        color: var(--color-text);
        background-color: var(--color-bg);
        margin: 0;
        padding: 0;
        word-wrap: break-word;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 2.5rem 1.5rem;
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-serif);
        font-weight: 500;
        margin-top: 2.25rem;
        margin-bottom: 1rem;
        line-height: 1.3;
        color: var(--color-text);
      }

      h1 {
        font-size: 2.2rem;
        letter-spacing: -0.01em;
        margin-top: 0;
        margin-bottom: 1.5rem;
        padding-bottom: 0.6rem;
        position: relative;
        display: block;
        border-bottom: 3px double var(--color-border);
      }

      h2 {
        font-size: 1.35rem;
        padding-bottom: 0.35rem;
        border-bottom: 1px solid var(--color-border);
      }
      h3 { font-size: 1.15rem; }

      a {
        color: var(--color-link);
        text-decoration: underline;
        text-underline-offset: 2px;
        text-decoration-thickness: 1px;
        text-decoration-color: var(--color-link);
        transition: color 0.15s ease, text-decoration-color 0.15s ease;
      }

      a:hover {
        color: var(--color-link-hover);
        text-decoration-color: var(--color-link-hover);
      }

      p {
        margin-bottom: 1.1rem;
      }

      ul, ol {
        margin-bottom: 1.25rem;
        padding-left: 1.5rem;
      }

      li {
        margin-bottom: 0.4rem;
      }

      blockquote {
        margin: 1.5rem 0;
        padding: 0.75rem 1.25rem;
        border-left: 3px solid var(--color-border);
        background-color: var(--color-box-bg);
        font-style: italic;
        color: var(--color-gray);
      }

      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
        font-size: 0.9em;
        background-color: var(--color-box-bg);
        border: 1px solid var(--color-border);
        padding: 0.1em 0.3em;
        border-radius: 2px;
      }

      pre {
        padding: 1.25rem;
        overflow-x: auto;
        background-color: var(--color-box-bg);
        border-radius: 0;
        margin-bottom: 1.5rem;
        border: 1px solid var(--color-border);
      }

      pre code {
        background-color: transparent;
        border: 0;
        padding: 0;
      }

      img {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 1.5rem 0;
        border: 1px solid var(--color-border);
      }

      hr {
        border: 0;
        border-top: 3px double var(--color-border);
        margin: 2.5rem 0;
      }

      small {
        font-size: 0.85em;
        color: var(--color-gray);
      }

      .quiet {
        color: var(--color-gray);
      }
    </style>
  </head>
  <body>
    <MathBackground {...mathBg} />
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <MathBackgroundMobileReveal {...mathBg} />
  </body>
</html>
